
# ─── API Keys ─────────────────────────────────────────

OPENAI_API_KEY=your_openai_api_key_here
GOOGLE_API_KEY=your_google_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# ─── Application ──────────────────────────────────────

DEBUG=True
DATABASE_URL=sqlite+aiosqlite:///./archlens.db

# ─── LLM Configuration ────────────────────────────────

LLM_PROVIDER=openai
LLM_MODEL=gpt-4o
LLM_MAX_TOKENS=4096
LLM_TEMPERATURE=0.1
LLM_MAX_RETRIES=3
LLM_TIMEOUT_SECONDS=30

# ─── LLM Caching ──────────────────────────────────────

LLM_CACHE_ENABLED=True
LLM_CACHE_TTL_SECONDS=3600

# ─── Computer Vision ──────────────────────────────────

CV_CONFIDENCE_THRESHOLD=0.5
CV_NMS_THRESHOLD=0.4
MAX_IMAGE_SIZE=1920

# ─── Git Analysis ─────────────────────────────────────

GIT_MAX_COMMITS=1000
GIT_BLAME_DEPTH=10
